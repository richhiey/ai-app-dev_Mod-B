# Local FieldCare service. Keep the caller key server-side in this UI project.
FIELDCARE_SERVICE_URL=http://127.0.0.1:8000
# Use a caller registered in your current service/fieldcare/security_settings.py.
# After the weekend-pilot checkpoint, use FIELDCARE_WEEKEND_PARTNER_KEY from FieldCare.
FIELDCARE_CALLER_KEY=replace_with_your_current_caller_key
